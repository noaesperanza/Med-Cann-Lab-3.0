# Supabase Configuration
# Copie este arquivo para .env e preencha com suas credenciais

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI (usado APENAS na Edge Function tradevision-core, NÃO no frontend)
# VITE_OPENAI_API_KEY=NÃO_USAR_NO_FRONTEND

# Stripe (configurar via Supabase Edge Function secrets)
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (configurar via Supabase Edge Function secrets)
# RESEND_API_KEY=re_xxx
